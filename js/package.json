{
  "name": "@reearth/mokuji",
  "version": "0.1.0",
  "description": "Read Mokuji files — a cloud-optimized search index — over HTTP range requests, in a browser, a worker or Node",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reearth/mokuji.git",
    "directory": "js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test 'test/*.test.js'"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
